<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="WinParted.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:app="using:WinParted.App"
    xmlns:controls="using:WinParted.App.Controls"
    xmlns:p="using:WinParted.Core.Presentation"
    Title="WinParted">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid RowDefinitions="Auto,*">
        <!--
            Title bar: app name, admin hint, Refresh (F5) and About. A plain grid rather than the TitleBar
            control, whose space for the window buttons was too wide at 150% display scaling. The last
            column reserves exactly the caption buttons' width (set from code), and the buttons get
            pointer passthrough so they stay clickable.
        -->
        <Grid x:Name="AppTitleBar" Height="48" ColumnSpacing="12" Padding="16,0,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition x:Name="CaptionButtonsColumn" Width="138" />
            </Grid.ColumnDefinitions>
            <FontIcon Glyph="&#xEDA2;" FontSize="16" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="WinParted" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="2" Text="{x:Bind TitleSubtitle}" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <StackPanel x:Name="TitleButtons" Grid.Column="4" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                <Button x:Name="RefreshButton" Click="OnRefreshClick" AutomationProperties.Name="Refresh" ToolTipService.ToolTip="Refresh (F5)"
                        Background="Transparent" BorderThickness="0" Padding="10,6" Visibility="{x:Bind HasViewModel}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE72C;" FontSize="14" />
                        <TextBlock Text="Refresh" />
                    </StackPanel>
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Key="F5" />
                    </Button.KeyboardAccelerators>
                </Button>
                <Button Click="OnAboutClick" AutomationProperties.Name="About WinParted" ToolTipService.ToolTip="About WinParted"
                        Background="Transparent" BorderThickness="0" Padding="10,6">
                    <FontIcon Glyph="&#xE946;" FontSize="14" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- Missing administrator rights (spec app-privileges). -->
        <Grid Grid.Row="1" Visibility="{x:Bind app:Ui.Hide(HasViewModel)}" Background="{ThemeResource LayerFillColorDefaultBrush}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" MaxWidth="440">
                <FontIcon Glyph="&#xEA18;" FontSize="36" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                <TextBlock Text="WinParted needs administrator rights to manage disks." Style="{StaticResource SubtitleTextBlockStyle}" TextAlignment="Center" TextWrapping="Wrap" />
                <TextBlock Text="Windows only lets administrators see and change partitions. Restart WinParted and approve the prompt."
                           TextAlignment="Center" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <Button Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Center" Click="OnRestartAsAdminClick" Margin="0,6,0,0">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xEA18;" FontSize="14" />
                        <TextBlock Text="Restart as administrator" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="300,*" Visibility="{x:Bind HasViewModel}">
            <!-- Disk list -->
            <Grid RowDefinitions="Auto,*" Padding="8,4,8,8">
                <TextBlock Text="Disks" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="12,8,12,8" />
                <ListView x:Name="DiskList" Grid.Row="1" ItemsSource="{x:Bind Vm.Disks}" SelectionMode="Single" SelectionChanged="OnDiskSelectionChanged"
                          SelectedItem="{x:Bind Vm.SelectedDisk, Mode=OneWay}"
                          AutomationProperties.Name="Disks">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="p:DiskView">
                            <Grid Padding="4,10" RowSpacing="4" AutomationProperties.Name="{x:Bind AutomationName}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                    <FontIcon Glyph="{x:Bind app:Ui.Glyph(BusIcon)}" FontSize="16" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind Title}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind SizeText}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Grid>
                                <StackPanel Grid.Row="1" Margin="24,0,0,0">
                                    <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind Meta}" Style="{StaticResource CaptionTextStyle}" />
                                </StackPanel>
                                <ItemsRepeater Grid.Row="2" Margin="24,2,0,0" ItemsSource="{x:Bind app:Ui.Chips(Chips)}" Visibility="{x:Bind app:Ui.Show(HasChips)}">
                                    <ItemsRepeater.Layout>
                                        <StackLayout Orientation="Horizontal" Spacing="4" />
                                    </ItemsRepeater.Layout>
                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate x:DataType="p:Chip">
                                            <Border CornerRadius="12" Padding="8,0" Height="24" BorderThickness="1"
                                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Background="{x:Bind app:Ui.ChipBackground(Tone)}">
                                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                    <FontIcon Glyph="{x:Bind app:Ui.Glyph(Icon)}" FontSize="12" Foreground="{x:Bind app:Ui.ChipForeground(Tone)}" />
                                                    <TextBlock Text="{x:Bind Text}" FontSize="12" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>
                                <controls:MiniBar Grid.Row="3" Margin="24,6,4,0" Disk="{x:Bind}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <!-- Content area -->
            <Grid Grid.Column="1" Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                  BorderThickness="1,1,0,0" CornerRadius="8,0,0,0">
                <ProgressBar IsIndeterminate="True" VerticalAlignment="Top" Visibility="{x:Bind app:Ui.Show(Vm.IsRefreshing), Mode=OneWay}"
                             AutomationProperties.Name="Refreshing disk information" />

                <!-- Loading (first read) -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" Visibility="{x:Bind app:Ui.Show(Vm.IsLoading), Mode=OneWay}">
                    <ProgressRing IsActive="True" Width="40" Height="40" />
                    <TextBlock Text="Reading disks…" Style="{StaticResource CaptionTextStyle}" HorizontalAlignment="Center" />
                </StackPanel>

                <!-- Load error -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" MaxWidth="460"
                            Visibility="{x:Bind app:Ui.Show(Vm.HasLoadError), Mode=OneWay}">
                    <FontIcon Glyph="&#xEA39;" FontSize="32" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                    <TextBlock Text="WinParted couldn't read disk information." Style="{StaticResource SubtitleTextBlockStyle}" TextAlignment="Center" TextWrapping="Wrap" />
                    <TextBlock Text="Windows didn't answer when WinParted asked for the list of disks. This can happen while another disk tool is busy."
                               TextWrapping="Wrap" TextAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Button Content="Try again" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Center" Command="{x:Bind Vm.RefreshCommand}" />
                    <Expander Header="Technical details" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                        <TextBlock Text="{x:Bind Vm.LoadErrorDetails, Mode=OneWay}" FontFamily="Cascadia Mono, Consolas" FontSize="12" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                    </Expander>
                </StackPanel>

                <!-- No disks -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" Visibility="{x:Bind app:Ui.Show(Vm.HasNoDisks), Mode=OneWay}">
                    <FontIcon Glyph="&#xEDA2;" FontSize="36" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="No disks found." Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" />
                    <TextBlock Text="Connected a disk just now? It can take a few seconds to appear." Style="{StaticResource CaptionTextStyle}" HorizontalAlignment="Center" />
                    <Button Content="Refresh" HorizontalAlignment="Center" Command="{x:Bind Vm.RefreshCommand}" />
                </StackPanel>

                <ScrollViewer Visibility="{x:Bind app:Ui.Show(Vm.ShowContent), Mode=OneWay}">
                    <StackPanel Padding="28,24,28,96" Spacing="20" MaxWidth="1200">
                        <!-- Header -->
                        <StackPanel Spacing="10">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <TextBlock Text="{x:Bind Vm.SelectedDisk.Title, Mode=OneWay, FallbackValue=''}" Style="{StaticResource TitleTextBlockStyle}" />
                                <TextBlock Text="{x:Bind Vm.SelectedDisk.Name, Mode=OneWay, FallbackValue=''}" VerticalAlignment="Bottom" Margin="0,0,0,4"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <ItemsRepeater ItemsSource="{x:Bind Vm.HeaderChips, Mode=OneWay}">
                                <ItemsRepeater.Layout>
                                    <StackLayout Orientation="Horizontal" Spacing="6" />
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="p:Chip">
                                        <Border CornerRadius="13" Padding="10,0" Height="26" BorderThickness="1"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Background="{x:Bind app:Ui.ChipBackground(Tone)}">
                                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                <FontIcon Glyph="{x:Bind app:Ui.Glyph(Icon)}" FontSize="12" Foreground="{x:Bind app:Ui.ChipForeground(Tone)}" />
                                                <TextBlock Text="{x:Bind Text}" FontSize="12" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                            <ItemsRepeater ItemsSource="{x:Bind Vm.DiskActionItems, Mode=OneWay}">
                                <ItemsRepeater.Layout>
                                    <StackLayout Orientation="Horizontal" Spacing="8" />
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="p:ActionItem">
                                        <Button Click="OnActionClick" Tag="{x:Bind}" Foreground="{x:Bind app:Ui.ActionForeground(IsEnabled)}"
                                                IsHitTestVisible="{x:Bind IsEnabled}" Background="{x:Bind app:Ui.ActionBackground(IsEnabled)}"
                                                AutomationProperties.FullDescription="{x:Bind Reason}">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <FontIcon Glyph="{x:Bind app:Ui.ActionGlyph(Kind)}" FontSize="14" />
                                                <TextBlock Text="{x:Bind Label}" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                            <ItemsRepeater ItemsSource="{x:Bind Vm.DiskReasonLines, Mode=OneWay}">
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE946;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Text="{x:Bind}" Style="{StaticResource CaptionTextStyle}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </StackPanel>

                        <!-- Not initialized -->
                        <Border Style="{StaticResource CardBorderStyle}" Padding="28" Visibility="{x:Bind app:Ui.Show(Vm.IsNotInitialized), Mode=OneWay}">
                            <StackPanel HorizontalAlignment="Center" Spacing="10">
                                <FontIcon Glyph="&#xE9F9;" FontSize="36" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="This disk isn't set up yet." Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" />
                                <TextBlock Text="Initialize it to choose a partition style. Then you can create partitions on it." HorizontalAlignment="Center"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <Button Content="Initialize" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Center" Click="OnInitializeClick" />
                            </StackPanel>
                        </Border>

                        <!-- Offline -->
                        <Border Style="{StaticResource CardBorderStyle}" Padding="28" Visibility="{x:Bind app:Ui.Show(Vm.IsOfflineDisk), Mode=OneWay}">
                            <StackPanel HorizontalAlignment="Center" Spacing="10">
                                <FontIcon Glyph="&#xE7E8;" FontSize="36" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="This disk is offline." Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" />
                                <TextBlock Text="Its volumes aren't available in Windows." HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{x:Bind Vm.OfflineReasonText, Mode=OneWay}" HorizontalAlignment="Center" Style="{StaticResource CaptionTextStyle}"
                                           Visibility="{x:Bind app:Ui.ShowIf(Vm.OfflineReasonText), Mode=OneWay}" />
                                <Button Content="Bring online" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Center" Click="OnBringOnlineClick" />
                            </StackPanel>
                        </Border>

                        <!-- Partition layout -->
                        <StackPanel Spacing="10" Visibility="{x:Bind app:Ui.Show(Vm.IsNormalDisk), Mode=OneWay}">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="Partition layout" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="16">
                                    <StackPanel Orientation="Horizontal" Spacing="6"><Border Width="12" Height="12" CornerRadius="3" Background="{ThemeResource SegmentUsedBrush}" /><TextBlock Text="Used" Style="{StaticResource CaptionTextStyle}" /></StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="6"><Border Width="12" Height="12" CornerRadius="3" Background="{ThemeResource SegmentFreeBrush}" BorderBrush="{ThemeResource SegmentStrokeBrush}" BorderThickness="1" /><TextBlock Text="Free in volume" Style="{StaticResource CaptionTextStyle}" /></StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="6"><Border Width="12" Height="12" CornerRadius="3" Background="{ThemeResource SegmentProtectedBrush}" BorderBrush="{ThemeResource SegmentProtectedStrokeBrush}" BorderThickness="1" /><TextBlock Text="Protected" Style="{StaticResource CaptionTextStyle}" /></StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="6"><Border Width="12" Height="12" CornerRadius="3" BorderBrush="{ThemeResource UnallocatedStrokeBrush}" BorderThickness="1" /><TextBlock Text="Unallocated" Style="{StaticResource CaptionTextStyle}" /></StackPanel>
                                </StackPanel>
                            </Grid>
                            <controls:LayoutBar x:Name="Bar" Segments="{x:Bind Vm.SegmentList, Mode=OneWay}" SelectedSegment="{x:Bind Vm.SelectedSegment, Mode=OneWay}"
                                                DiskSizeText="{x:Bind Vm.SelectedDisk.SizeText, Mode=OneWay, FallbackValue=''}"
                                                SegmentSelected="OnSegmentSelected" ActionsRequested="OnActionsRequested" />
                        </StackPanel>

                        <!-- Details and actions -->
                        <Grid ColumnDefinitions="3*,2*" ColumnSpacing="16" Visibility="{x:Bind app:Ui.Show(Vm.ShowContent), Mode=OneWay}">
                            <Border Style="{StaticResource CardBorderStyle}" VerticalAlignment="Top">
                                <StackPanel Spacing="12">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="{x:Bind Vm.Details.Title, Mode=OneWay, FallbackValue=''}" Style="{StaticResource SubtitleTextBlockStyle}" />
                                            <TextBlock Text="{x:Bind Vm.Details.Role, Mode=OneWay, FallbackValue=''}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                        <Border Grid.Column="1" VerticalAlignment="Top" CornerRadius="12" Padding="8,2" Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                Visibility="{x:Bind app:Ui.Show(Vm.DetailsLocked), Mode=OneWay}">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xE72E;" FontSize="12" />
                                                <TextBlock Text="Protected" FontSize="12" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                    <StackPanel Spacing="4" Visibility="{x:Bind app:Ui.Show(Vm.DetailsHasUsage), Mode=OneWay}">
                                        <ProgressBar Value="{x:Bind Vm.DetailsUsedPercent, Mode=OneWay}" Maximum="100" Height="8" CornerRadius="4"
                                                     AutomationProperties.Name="{x:Bind Vm.Details.UsageText, Mode=OneWay, FallbackValue=''}" />
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Text="{x:Bind Vm.Details.UsageText, Mode=OneWay, FallbackValue=''}" Style="{StaticResource CaptionTextStyle}" />
                                            <TextBlock Grid.Column="1" Text="{x:Bind Vm.Details.PercentText, Mode=OneWay, FallbackValue=''}" Style="{StaticResource CaptionTextStyle}" />
                                        </Grid>
                                    </StackPanel>
                                    <InfoBar IsOpen="True" IsClosable="False" Severity="Informational" Message="{x:Bind Vm.DetailsHint, Mode=OneWay}"
                                             Visibility="{x:Bind app:Ui.ShowIf(Vm.DetailsHint), Mode=OneWay}" />
                                    <ItemsRepeater ItemsSource="{x:Bind Vm.DetailsFlags, Mode=OneWay}">
                                        <ItemsRepeater.Layout>
                                            <StackLayout Orientation="Horizontal" Spacing="6" />
                                        </ItemsRepeater.Layout>
                                        <ItemsRepeater.ItemTemplate>
                                            <DataTemplate x:DataType="x:String">
                                                <Border CornerRadius="10" Padding="8,1" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                                    <TextBlock Text="{x:Bind}" FontSize="12" />
                                                </Border>
                                            </DataTemplate>
                                        </ItemsRepeater.ItemTemplate>
                                    </ItemsRepeater>
                                    <ItemsRepeater ItemsSource="{x:Bind Vm.DetailsRows, Mode=OneWay}">
                                        <ItemsRepeater.Layout>
                                            <StackLayout Spacing="6" />
                                        </ItemsRepeater.Layout>
                                        <ItemsRepeater.ItemTemplate>
                                            <DataTemplate x:DataType="p:DetailRow">
                                                <Grid ColumnDefinitions="140,*,Auto" ColumnSpacing="12">
                                                    <TextBlock Text="{x:Bind Label}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    <TextBlock Grid.Column="1" Text="{x:Bind Value}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                                    <Button Grid.Column="2" Padding="6,2" Background="Transparent" BorderThickness="0" Click="OnCopyClick" Tag="{x:Bind Value}"
                                                            Visibility="{x:Bind app:Ui.Show(Copyable)}" AutomationProperties.Name="Copy" ToolTipService.ToolTip="Copy">
                                                        <FontIcon Glyph="&#xE8C8;" FontSize="12" />
                                                    </Button>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsRepeater.ItemTemplate>
                                    </ItemsRepeater>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}" Padding="6,12,6,8" VerticalAlignment="Top"
                                    Visibility="{x:Bind app:Ui.ShowIf(Vm.Actions), Mode=OneWay}">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{x:Bind Vm.Actions.Title, Mode=OneWay, FallbackValue=''}" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="12,0,12,6" />
                                    <ItemsRepeater x:Name="ActionGroups" ItemsSource="{x:Bind Vm.ActionGroupList, Mode=OneWay}">
                                        <ItemsRepeater.ItemTemplate>
                                            <DataTemplate x:DataType="p:ActionGroup">
                                                <StackPanel Spacing="0">
                                                    <TextBlock Text="{x:Bind Name}" Style="{StaticResource CaptionTextStyle}" Margin="12,8,12,2" />
                                                    <ItemsRepeater ItemsSource="{x:Bind app:Ui.Items(Items)}">
                                                        <ItemsRepeater.ItemTemplate>
                                                            <DataTemplate x:DataType="p:ActionItem">
                                                                <StackPanel>
                                                                    <Button Style="{StaticResource ActionRowButtonStyle}" Click="OnActionClick" Tag="{x:Bind}" IsHitTestVisible="{x:Bind IsEnabled}"
                                                                            Foreground="{x:Bind app:Ui.ActionForeground(IsEnabled)}" AutomationProperties.FullDescription="{x:Bind Reason}">
                                                                        <StackPanel Orientation="Horizontal" Spacing="12">
                                                                            <FontIcon Glyph="{x:Bind app:Ui.ActionGlyph(Kind)}" FontSize="16" />
                                                                            <TextBlock Text="{x:Bind Label}" />
                                                                        </StackPanel>
                                                                    </Button>
                                                                    <TextBlock Text="{x:Bind Reason}" Style="{StaticResource CaptionTextStyle}" Margin="40,-4,12,8"
                                                                               Visibility="{x:Bind app:Ui.ShowIf(Reason)}" />
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </ItemsRepeater.ItemTemplate>
                                                    </ItemsRepeater>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsRepeater.ItemTemplate>
                                    </ItemsRepeater>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>

                <!-- Bottom of the content area: notifications at the right (newest on top), and the
                     running-operation bar (task 12.1) below them while an operation runs. -->
                <StackPanel VerticalAlignment="Bottom" Margin="16" Spacing="8">
                    <ItemsRepeater ItemsSource="{x:Bind Vm.Toasts}" HorizontalAlignment="Right" Width="440">
                        <ItemsRepeater.Layout>
                            <StackLayout Spacing="8" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="app:Toast">
                                <InfoBar IsOpen="{x:Bind IsOpen, Mode=TwoWay}" Message="{x:Bind Message}" Severity="{x:Bind app:Ui.Severity(Kind)}" Closed="OnToastClosed">
                                    <InfoBar.ActionButton>
                                        <Button Content="{x:Bind ActionText}" Visibility="{x:Bind app:Ui.Show(HasAction)}" Click="OnToastActionClick" Tag="{x:Bind}" />
                                    </InfoBar.ActionButton>
                                </InfoBar>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                    <InfoBar IsOpen="{x:Bind Vm.IsBusy, Mode=OneWay}" IsClosable="False" Severity="Informational"
                             Title="{x:Bind Vm.BusyText, Mode=OneWay}" Message="{x:Bind Vm.BusyHint, Mode=OneWay}"
                             AutomationProperties.LiveSetting="Polite">
                        <ProgressBar IsIndeterminate="{x:Bind Vm.BusyIsIndeterminate, Mode=OneWay}" Value="{x:Bind Vm.BusyValue, Mode=OneWay}" Maximum="100" Margin="0,0,0,12"
                                     AutomationProperties.Name="{x:Bind Vm.BusyText, Mode=OneWay}" />
                    </InfoBar>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
