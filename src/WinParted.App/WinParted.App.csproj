<Project Sdk="Microsoft.NET.Sdk">

  <!-- WinUI 3 desktop app: unpackaged, self-contained, always elevated (design D1). -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>$(WinPartedWindowsTfm)</TargetFramework>
    <TargetPlatformMinVersion>$(WinPartedMinWindows)</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>$(WinPartedMinWindows)</SupportedOSPlatformVersion>
    <RootNamespace>WinParted.App</RootNamespace>
    <AssemblyName>WinParted</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationManifest Condition="'$(Configuration)' == 'Debug'">app.debug.manifest</ApplicationManifest>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and '$(Platform)' == 'ARM64'">win-arm64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <!-- Without it, publish leaves out WinParted.pri and the .xbf files and the window fails to load. -->
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <!-- Only the parts WinParted uses: the full Microsoft.WindowsAppSDK package adds ~50 MB of AI/ML runtimes. -->
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="2.6.5" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Runtime" Version="2.6.5" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2957" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WinParted.Core\WinParted.Core.csproj" />
    <ProjectReference Include="..\WinParted.Storage\WinParted.Storage.csproj" />
  </ItemGroup>

</Project>
