<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Throwaway experiments (tasks group 2). Not part of WinParted.sln.
    Run from an elevated terminal; see spikes/README.md.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>$(WinPartedWindowsTfm)</TargetFramework>
    <SupportedOSPlatformVersion>$(WinPartedMinWindows)</SupportedOSPlatformVersion>
    <RootNamespace>WinParted.Spikes</RootNamespace>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Management.Infrastructure" Version="3.0.0" />
  </ItemGroup>

</Project>
